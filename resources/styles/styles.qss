Login_View {
    background-color: white;
    font-family: "Inter", sans-serif;
}

QHeaderView {
    background-color: white;
    border: none;
}
QTableCornerButton::section {
    background-color: white;
    border: none;
}

QMainWindow, QStackedWidget, QWidget#centralwidget {
    background-color: #F8FAFC;
}

QComboBox, QSpinBox, QDateEdit, QTimeEdit, QDateTimeEdit {
    color: #1e293b;
    background-color: white;
}

QComboBox QAbstractItemView {
    background-color: white;
    color: #1e293b;
    selection-background-color: #3b82f6;
    selection-color: white;
}


QFrame#frmLoginLeft {
    background-color: #f4f8fc;
    border-right: 1px solid #e0e8f0;
}


QFrame#frmLoginRight {
    background-color: transparent;
    background-origin: content;
    background-repeat: no-repeat;
    background-position: center;
    border-top-right-radius: 20px;
    border-bottom-right-radius: 20px;
    border: none;
}

QLabel#lblTitle {
    color: #1a73e8; /* Màu xanh sáng (Google Blue) */
    font-size: 48px; /* Nhỏ lại một chút xíu (trước đó là 52) */
    font-weight: 900; /* Dày nhất có thể */
    letter-spacing: 1.5px;
    padding-bottom: 28px;
}

QLabel#lblUsername,
QLabel#lblPassword {
    color: #1e293b;
    font-size: 17px; /* Nhỏ lại một xíu (trước đó 19) */
    font-weight: bold; /* In đậm */
    letter-spacing: 0.5px;
    padding-left: 5px;
    padding-top: 8px;
    padding-bottom: 5px;
}

QLineEdit#txtLoginUsername,
QLineEdit#txtLoginPassword {
    background-color: #f8fafc;

    min-height: 52px; /* Giảm chiều cao */
    font-size: 16px;  /* Giảm chữ gõ vào (trước đó 17) */
    font-weight: 500;

    color: #0f172a;

    border: 1.5px solid #e2e8f0;
    border-radius: 12px;

    padding: 0px 40px 0px 18px;
    selection-background-color: #2563eb;
    selection-color: #ffffff;
}

QLineEdit#txtLoginUsername::placeholder,
QLineEdit#txtLoginPassword::placeholder {
    color: rgba(44, 62, 80, 45%);
}


QLineEdit#txtLoginUsername:hover,
QLineEdit#txtLoginPassword:hover {
    background-color: rgba(140, 200, 255, 16%);
    border: 1px solid rgba(160, 220, 255, 50%);
}


QLineEdit#txtLoginUsername:focus,
QLineEdit#txtLoginPassword:focus {
    background-color: rgba(160, 210, 255, 18%);
    border: 1px solid rgba(180, 230, 255, 80%);
    outline: none;
}

/* Eye-icon button bên trong QLineEdit */
QLineEdit QToolButton {
    background: transparent;
    border: none;
    padding: 2px;
}


QPushButton#btnLogin {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0   #3b82f6,
        stop:1   #2563eb
    );
    color: #ffffff;
    font-size: 18px; /* Giảm lại nút (trước đó 20) */
    font-weight: bold;
    letter-spacing: 1px;

    border: none;
    border-radius: 12px;
    min-width: 160px;
    min-height: 52px; /* Thấp lại */
    padding: 10px 0px;
    margin-top: 20px;
}


QPushButton#btnLogin:hover {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0   rgba(80, 150, 255, 90%),
        stop:0.5 rgba(110, 190, 255, 90%),
        stop:1   rgba(150, 230, 255, 90%)
    );
    border: 1px solid rgba(180, 235, 255, 60%);
}


QPushButton#btnLogin:pressed {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 rgba(40, 100, 200, 80%),
        stop:1 rgba(70, 150, 230, 80%)
    );
    padding-top: 13px;
    border: 1px solid rgba(120, 190, 255, 60%);
}

/* --- Profile View Base Layout --- */
#profileScrollArea {
    background-color: #f7f9fc;
    border: none;
}

#profileContentWidget {
    background-color: #f7f9fc;
}

/* --- Card Styling --- */
QFrame#cardGeneral, QFrame#cardDetailed {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
}

/* --- Headers & Banners --- */
/* Blue Banner (Thông tin chung) */
QFrame#bannerGeneral {
    background-color: #003c71; /* Deep Blue */
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
    border-bottom-left-radius: 0px;
    border-bottom-right-radius: 0px;
    min-height: 50px;
    max-height: 50px;
}

QLabel#lblTitleGeneral {
    color: #ffffff;
    font-family: "Segoe UI", Arial, sans-serif;
    font-size: 20px;
    font-weight: bold;
    padding-left: 15px;
}

/* Slanted Orange Banner (Thông tin chi tiết) */
QFrame#bannerDetailed {
    /* Creates a slanted diagonal separator at 30% width using a sharp gradient transition */
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #e07a12,
        stop:0.40 #e07a12,
        stop:0.45 transparent,
        stop:1.0 transparent
    );
    border: none;
    min-height: 50px;
    max-height: 50px;
}

QLabel#lblTitleDetailed {
    color: #ffffff;
    font-family: "Segoe UI", Arial, sans-serif;
    font-size: 20px;
    font-weight: bold;
    padding-left: 15px;
}

/* --- Profile Left Column --- */
QLabel#lblAvatar {
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    background-color: #f1f5f9;
}

QLabel#lblProfileName {
    color: #1e293b;
    font-family: "Segoe UI", Arial, sans-serif;
    font-size: 18px;
    font-weight: bold;
}

QLabel#lblProfileRole {
    color: #64748b;
    font-family: "Segoe UI", Arial, sans-serif;
    font-size: 14px;
}

/* --- Info Details Labels --- */
/* Small header text */
QLabel[class="lblFieldTitle"] {
    color: #94a3b8;
    font-family: "Segoe UI", Arial, sans-serif;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
}

/* Value text */
QLabel[class="lblFieldValue"] {
    color: #0f172a;
    font-family: "Segoe UI", Arial, sans-serif;
    font-size: 14px;
    font-weight: 700;
}

/* --- Profile & Password Edit Info Button --- */
QPushButton#btnEditInfo {
    background-color: #003c71; /* Deep Blue matching General Banner */
    color: #ffffff;
    border: none;
    border-radius: 10px;
    padding: 8px 16px;
    font-family: "Segoe UI", Arial, sans-serif;
    font-size: 13px;
    font-weight: 600;
    min-height: 32px;
}

QPushButton#btnEditInfo:hover {
    background-color: #002b52;
}

QPushButton#btnEditInfo:pressed {
    background-color: #001f3d;
}


QPushButton#btnEditPassword {
    background-color: #003c71; /* Deep Blue matching General Banner */
    color: #ffffff;
    border: none;
    border-radius: 10px;
    padding: 8px 16px;
    font-family: "Segoe UI", Arial, sans-serif;
    font-size: 13px;
    font-weight: 600;
    min-height: 32px;
}

QPushButton#btnEditPassword:hover {
    background-color: #002b52;
}

QPushButton#btnEditPassword:pressed {
    background-color: #001f3d;
}


/* ╔══════════════════════════════════════════════════════════╗ */
/* ║          Employee_View  —  F&B Dashboard Theme         ║ */
/* ║  Sections:                                               ║ */
/* ║    1. Root Widget                                        ║ */
/* ║    2. Profile Block (top-right user card)                ║ */
/* ║    3. Metric Summary Cards                               ║ */
/* ║    4. Roster Card (header, search, filter, add-btn)      ║ */
/* ║    5. Staff Table                                        ║ */
/* ║    6. Table Footer                                       ║ */
/* ║    7. Shared Scrollbars                                  ║ */
/* ╚══════════════════════════════════════════════════════════╝ */


/* ── 1. ROOT WIDGET ─────────────────────────────────────── */

Employee_View {
    background-color: #F8FAFC;
    color: #0F172A;
    font-family: "Segoe UI", "Inter", Arial, sans-serif;
}


/* ── 2. PROFILE BLOCK ───────────────────────────────────── */

Employee_View #profileBlock {
    background-color: transparent;
    min-height: 52px;
    max-height: 52px;
}

Employee_View #lblPageTitle {
    color: #0F172A;
    font-size: 20px;
    font-weight: 700;
}

/* Clickable user identity card */
Employee_View #userCard {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 10px;
}
Employee_View #userCard:hover {
    background-color: #F1F5F9;
    border-color: #BFDBFE;
}

/*
 * NOTE: userAvatar background-color is set inline in C++ because
 * it carries the accent blue colour (#2563EB) which is not a
 * named-object property.
 */

Employee_View #userName {
    color: #1E293B;
    font-size: 13px;
    font-weight: 700;
}

Employee_View #userRole {
    color: #64748B;
    font-size: 11px;
    font-weight: 500;
}

Employee_View #userCaret {
    color: #94A3B8;
    font-size: 16px;
    font-weight: bold;
    background-color: transparent;
}


/* ── 3. METRIC SUMMARY CARDS ────────────────────────────── */

Employee_View #metricCard {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 14px;
}
Employee_View #metricCard:hover {
    border-color: #BFDBFE;
    background-color: #F8FBFF;
}

Employee_View #metricTitle {
    color: #64748B;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.4px;
}

Employee_View #metricValue {
    color: #0F172A;
    font-size: 26px;
    font-weight: 700;
}

Employee_View #metricSubtitle {
    color: #94A3B8;
    font-size: 11px;
}

/*
 * NOTE: metricIcon background-color / border-radius are set inline
 * in C++ because each card requires a different colour token.
 */


/* ── 4. ROSTER CARD ─────────────────────────────────────── */

Employee_View #rosterCard {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 14px;
}

Employee_View #rosterHeader {
    background-color: transparent;
}

Employee_View #rosterTitle {
    color: #0F172A;
    font-size: 15px;
    font-weight: 700;
}

Employee_View #rosterSubtitle {
    color: #94A3B8;
    font-size: 11px;
}

Employee_View #tableDivider {
    color: #E2E8F0;
    max-height: 1px;
}

/* Search bar inside roster header */
Employee_View #searchRoster {
    background-color: #F8FAFC;
    color: #374151;
    border: 1px solid #E2E8F0;
    border-radius: 8px;
    padding: 3px 12px;
    font-size: 12px;
}
Employee_View #searchRoster:focus {
    border: 1px solid #93C5FD;
    background-color: #FFFFFF;
}

/* Sort / Filter combo box */
Employee_View #filterCombo {
    background-color: #F8FAFC;
    color: #374151;
    border: 1px solid #E2E8F0;
    border-radius: 8px;
    padding: 3px 8px;
    font-size: 12px;
    min-width: 100px;
}
Employee_View #filterCombo:hover {
    border-color: #93C5FD;
    background-color: #F1F5F9;
}
Employee_View #filterCombo::drop-down {
    border: none;
    width: 20px;
}
Employee_View #filterCombo QAbstractItemView {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 6px;
    selection-background-color: #EFF6FF;
    selection-color: #1E40AF;
    outline: none;
}

/* Add Staff primary button */
Employee_View #addEmployeeBtn {
    background-color: #2563EB;
    color: #FFFFFF;
    border: none;
    border-radius: 8px;
    padding: 0px 16px;
    font-size: 12px;
    font-weight: 600;
    min-width: 100px;
}
Employee_View #addEmployeeBtn:hover {
    background-color: #1D4ED8;
}
Employee_View #addEmployeeBtn:pressed {
    background-color: #1E40AF;
}

/* Filter / Sort icon buttons — light theme */
Employee_View #filterBtn,
Employee_View #sortBtn {
    background-color: #F1F5F9;
    border: 1px solid #CBD5E1;
    border-radius: 8px;
    color: #374151;
    padding: 0px;
}
Employee_View #filterBtn:hover,
Employee_View #sortBtn:hover {
    background-color: #E2E8F0;
    border-color: #93C5FD;
}
Employee_View #filterBtn:pressed,
Employee_View #sortBtn:pressed {
    background-color: #CBD5E1;
}

/* Filter / Sort floating dropdowns — light theme */
Employee_View #filterDropdown,
Employee_View #sortDropdown {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 10px;
    color: #1E293B;
}
Employee_View #filterDropdown QCheckBox,
Employee_View #sortDropdown QCheckBox {
    color: #374151;
    font-size: 12px;
    spacing: 6px;
}
Employee_View #filterDropdown QCheckBox::indicator,
Employee_View #sortDropdown QCheckBox::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid #CBD5E1;
    border-radius: 3px;
    background: #F8FAFC;
}
Employee_View #filterDropdown QCheckBox::indicator:checked,
Employee_View #sortDropdown QCheckBox::indicator:checked {
    background: #2563EB;
    border-color: #3B82F6;
}
Employee_View #filterSectionLabel {
    color: #94A3B8;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.5px;
}
Employee_View #filterSeparator {
    color: #E2E8F0;
    max-height: 1px;
}
Employee_View #sortDropdownItem {
    color: #374151;
    font-size: 12px;
    background: transparent;
    border: none;
    border-radius: 6px;
    text-align: left;
    padding: 5px 10px;
}
Employee_View #sortDropdownItem:hover {
    background-color: #F1F5F9;
    color: #2563EB;
}


/* ── 5. STAFF TABLE ─────────────────────────────────────── */

Employee_View #employeesTable {
    background-color: #FFFFFF;
    alternate-background-color: #F8FAFC;
    color: #0F172A;
    border: none;
    gridline-color: transparent;
    selection-background-color: #EFF6FF;
    selection-color: #1E40AF;
    outline: none;
}

Employee_View #employeesTable::item {
    padding: 5px 8px;
    border-bottom: 1px solid #F1F5F9;
}
Employee_View #employeesTable::item:hover {
    background-color: #F0F9FF;
}
Employee_View #employeesTable::item:selected {
    background-color: #EFF6FF;
    color: #1E40AF;
}

Employee_View QHeaderView {
    background-color: transparent;
}
Employee_View QHeaderView::section {
    background-color: #F8FAFC;
    color: #64748B;
    padding: 9px 8px;
    border: none;
    border-bottom: 2px solid #E2E8F0;
    font-weight: 700;
    font-size: 10px;
    letter-spacing: 0.5px;
}

Employee_View #empNameLabel {
    color: #1E293B;
    font-size: 12px;
    font-weight: 600;
    background-color: transparent;
}

/*
 * NOTE: empAvatar, role badges, status badges use inline styles
 * in C++ because each instance requires a unique colour.
 */

/* Edit / Delete icon buttons */
Employee_View #tableActionBtn {
    background-color: transparent;
    border: 1px solid #E2E8F0;
    border-radius: 6px;
    font-size: 13px;
}
Employee_View #tableActionBtn:hover {
    background-color: #F1F5F9;
    border-color: #CBD5E1;
}
Employee_View #tableActionBtn:pressed {
    background-color: #E2E8F0;
}


/* ── 6. TABLE FOOTER ────────────────────────────────────── */

Employee_View #tableFooterFrame {
    background-color: #F8FAFC;
    border-top: 1px solid #E2E8F0;
    border-bottom-left-radius: 14px;
    border-bottom-right-radius: 14px;
}

Employee_View #footerLabel {
    color: #94A3B8;
    font-size: 11px;
}


/* ── 7. SCROLLBARS ──────────────────────────────────────── */

QScrollBar:vertical {
    border: none;
    background-color: #F8FAFC;
    width: 7px;
    margin: 0px;
}
QScrollBar::handle:vertical {
    background-color: #CBD5E1;
    min-height: 24px;
    border-radius: 3px;
}
QScrollBar::handle:vertical:hover {
    background-color: #94A3B8;
}
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    border: none;
    background-color: #F8FAFC;
    height: 7px;
    margin: 0px;
}
QScrollBar::handle:horizontal {
    background-color: #CBD5E1;
    min-width: 24px;
    border-radius: 3px;
}
QScrollBar::handle:horizontal:hover {
    background-color: #94A3B8;
}
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0px;
}

Employee_View QLabel#userAvatar {
    background-color: #2563EB;
    color: #FFFFFF;
    border-radius: 18px;
    font-size: 12px;
    font-weight: bold;
}
/* ========================================= */
/* STYLE CHO BẢNG LỊCH LÀM VIỆC (TABLE)      */
/* ========================================= */

QLabel#DangKyLich,
QLabel#XacNhanLich {
    color: #1F2937;
    font-size: 18px;
    font-weight: 700;
    background-color: transparent;
}


QTableWidget[role="staff"] {
    border: none;
    background-color: white;
    color: #0F172A;
    gridline-color: #EFEFEF;
    selection-background-color: #3b82f6;
    selection-color: white;
}
QTableWidget[role="staff"] QHeaderView::section {
    background-color: #E0F2FE;
    border: none;
    border-bottom: 2px solid #BAE6FD;
    padding: 8px;
    font-weight: bold;
    color: #0c4a6e;
    text-transform: uppercase;
}
QTableWidget[role="staff"] QHeaderView::section:vertical {
    background-color: #E5E7EB;
    color: black;
    border: none;
    font-weight: bold;
}
QTableWidget[role="staff"] QHeaderView {
    background-color: white;
    border: none;
}
QTableWidget[role="staff"] QTableCornerButton::section {
    background-color: #E0F2FE;
    border: none;
}


QTableWidget[role="manager"] {
    border: none;
    background-color: white;
    color: #0F172A;
    gridline-color: #EFEFEF;
    selection-background-color: #3b82f6;
    selection-color: white;
}
QTableWidget[role="manager"] QHeaderView::section {
    background-color: #A855F7; /* Đổi màu nền tím ở đây */
    border: none;
    border-bottom: 2px solid #9333EA;
    border-right: 1px solid #9333EA;
    padding: 8px;
    font-weight: bold;
    color: white; /* Màu chữ trắng ở đây */
    text-transform: uppercase;
}
QTableWidget[role="manager"] QHeaderView {
    background-color: white;
    border: none;
}
QTableWidget[role="manager"] QTableCornerButton::section {
    background-color: #A855F7;
    border: none;
}


QTableWidget[role="manager-dark"] {
    border: 1px solid #E5E7EB;
    background-color: white;
    color: #0F172A;
    gridline-color: #E5E7EB;
    selection-background-color: #3b82f6;
    selection-color: white;
}
QTableWidget[role="manager-dark"] QHeaderView::section {
    background-color: #9333EA;
    border: none;
    border-right: 1px solid #E5E7EB;
    border-bottom: 2px solid #E5E7EB;
    padding: 8px;
    font-weight: bold;
    color: white;
    text-transform: uppercase;
}
QTableWidget[role="manager-dark"] QHeaderView {
    background-color: white;
    border: none;
}
QTableWidget[role="manager-dark"] QTableCornerButton::section {
    background-color: #9333EA;
    border: none;
}

/* ========================================= */
/* DIALOGS & INPUT DIALOGS                   */
/* ========================================= */

QInputDialog {
    background-color: #FFFFFF;
}

QInputDialog QLabel {
    color: #0F172A;
    font-size: 13px;
    font-weight: 600;
    background-color: transparent;
    padding-bottom: 4px;
}

QInputDialog QLineEdit {
    background-color: #F8FAFC;
    color: #0F172A;
    border: 1px solid #CBD5E1;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 13px;
    min-height: 24px;
    selection-background-color: #2563EB;
    selection-color: #FFFFFF;
}

QInputDialog QLineEdit:focus {
    border-color: #2563EB;
    background-color: #FFFFFF;
}

QInputDialog QComboBox {
    background-color: #F8FAFC;
    color: #0F172A;
    border: 1px solid #CBD5E1;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 13px;
    min-height: 24px;
}

QInputDialog QComboBox:focus {
    border-color: #2563EB;
    background-color: #FFFFFF;
}

QInputDialog QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    color: #0F172A;
    selection-background-color: #EFF6FF;
    selection-color: #1E40AF;
    border: 1px solid #CBD5E1;
    border-radius: 6px;
    outline: none;
}

QInputDialog QPushButton {
    background-color: #2563EB;
    color: #FFFFFF;
    border: none;
    border-radius: 6px;
    padding: 7px 18px;
    font-weight: 600;
    font-size: 12px;
    min-width: 65px;
    min-height: 20px;
}

QInputDialog QPushButton:hover {
    background-color: #1D4ED8;
}

QInputDialog QPushButton:pressed {
    background-color: #1E40AF;
}



